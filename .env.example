# ============================================================================
# Prisma AIRS AIGW Hybrid POC - Environment Variables
# Copy to .env and fill in the values.  DO NOT commit .env.
# ============================================================================

# --- AIGW ingress Basic Auth (protects both aigw.local and mcp-aigw.local) ---
AIGW_USER=aigwuser
AIGW_PASS=CHANGE_ME_STRONG_PASSWORD

# --- Chat frontend LEGACY login (used when OIDC is disabled or ?legacy=1) ---
CHAT_USER=admin
CHAT_PASS=CHANGE_ME_STRONG_CHAT_PASSWORD
# Any long random string. Used to sign session cookies (HMAC). Auto-generated
# by deploy.sh if left as CHANGE_ME_LONG_RANDOM_HEX, but you should persist
# your own value here for stable sessions across re-deploys.
CHAT_SESSION_SECRET=CHANGE_ME_LONG_RANDOM_HEX

# --- LLM provider: Google AI Studio Gemini ---
# Get a free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=REPLACE_ME_GEMINI_KEY
GEMINI_MODEL=gemini-2.5-flash

# --- GitHub MCP server (PAT with repo:read scope) ---
GITHUB_TOKEN=ghp_REPLACE_ME

# --- Weather MCP server (free tier: https://openweathermap.org/api) ---
OPENWEATHER_API_KEY=REPLACE_ME_OPENWEATHER_KEY

# ============================================================================
# Phase 1-3: Keycloak OIDC (BFF on agent-api + JWT auth on Portkey)
# ----------------------------------------------------------------------------
# Defaults below match keycloak/04-realm-import-configmap.yaml + the seeded
# 'aigw-chat' confidential client.  Rotate for anything beyond POC.
# ============================================================================
OIDC_CLIENT_ID=aigw-chat
OIDC_CLIENT_SECRET=aigw-chat-client-secret-CHANGE-ME
# The following are baked into manifests/70-agent-api.yaml and generally do
# NOT need overriding for the local kind-based POC.  Documented here for
# completeness / prod adaptation:
#   OIDC_ISSUER=http://keycloak.test/realms/aigw
#   OIDC_REDIRECT_URI=http://chat.local/api/auth/callback
#   OIDC_POST_LOGOUT_REDIRECT_URI=http://chat.local/
#   OIDC_JWKS_URL=http://keycloak.keycloak.svc.cluster.local:8080/realms/aigw/protocol/openid-connect/certs
#   OIDC_SCOPES="openid email profile aigw-api"

# ============================================================================
# Phase 4: Redis session store for agent-api
# ----------------------------------------------------------------------------
# Baked into manifests/70-agent-api.yaml + manifests/25-redis-sessions.yaml.
# Documented here for prod adaptation (e.g. GCP Memorystore, AWS ElastiCache).
#   REDIS_URL=redis://redis.agent-app.svc.cluster.local:6379/0
# ============================================================================

# --- (Optional / future) Prisma AIRS - wired later via SCM control plane ---
# AIRS_API_KEY=
# AIRS_PROFILE_NAME=
# AIRS_API_ENDPOINT=https://service.api.aisecurity.paloaltonetworks.com
