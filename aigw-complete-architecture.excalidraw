      "height": 80,
      "fontSize": 11,
      "fontFamily": 1,
      "text": "1️⃣ User Message\nPOST /api/chat\n  {message: \"...\"}\n\nRetrieve session:\n- Extract cookie\n- Load from Redis\n- Refresh if < 30s",
      "textAlign": "left",
      "verticalAlign": "middle",
