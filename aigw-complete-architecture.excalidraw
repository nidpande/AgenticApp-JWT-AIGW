      "height": 100,
      "fontSize": 11,
      "fontFamily": 1,
      "text": "5️⃣ Store in Redis\naigw-chat:sid:*\n\nClaims:\n- access_token\n- refresh_token\n- id_token\n- username, email\n- groups\n\nTTL: token_exp + 30s",
      "textAlign": "left",
      "verticalAlign": "middle",
      "strokeColor": "#991b1b",
